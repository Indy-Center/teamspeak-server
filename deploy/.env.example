# Runtime settings the deploy writes to .env. Names only, no values.
# Only teamspeak-bot reads them; the TeamSpeak service doesn't load .env.

# teamspeak-bot's own ServerQuery login (GitHub: variable ENV_QUERY_USER, secret ENV_QUERY_PASSWORD).
QUERY_USER=
QUERY_PASSWORD=

# larry's Worker and the secret its teamspeak-bot routes check (GitHub: variable ENV_LARRY_URL,
# secret ENV_LARRY_SECRET, the same value as indy-larry's ENV_TEAMSPEAK_BOT_SECRET).
LARRY_URL=
LARRY_SECRET=
